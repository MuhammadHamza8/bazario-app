# Copy this file to ".env" and fill in the values.
NODE_ENV=development
PORT=5000
# Local MongoDB, or a free MongoDB Atlas (M0) connection string
MONGO_URI=mongodb://127.0.0.1:27017/bazario
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
RESET_TOKEN_EXPIRES_MINUTES=30
CLIENT_URL=http://localhost:3000
# Optional real SMTP (e.g. Gmail app password). Leave empty to use the Ethereal fake inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional cache. With Redis running in WSL use: redis://127.0.0.1:6379
REDIS_URL=
